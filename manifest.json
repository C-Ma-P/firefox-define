{
  "manifest_version": 3,
  "name": "Define",
  "version": "0.3.1",
  "description": "Right-click selected text to show its Wiktionary definition in a small popup.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://en.wiktionary.org/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "define@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "commands": {
    "define-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Define the selected word or phrase"
    }
  },
  "icons": {
    "16": "icons/wiktionary.svg",
    "32": "icons/wiktionary.svg",
    "48": "icons/wiktionary.svg",
    "96": "icons/wiktionary.svg"
  }
}
